// ---------- Versões ----------
// Fênix Gestor de Tempo v3.0 — projeto Firebase próprio do Gestor (NÃO é o fenix-core-19e82)
// firestore-rules-gestor-v1

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    // Administrador = existe o documento admins/{uid}, criado à mão no console.
    function ehAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function aprovado() {
      return logado()
        && exists(/databases/$(database)/documents/perfis/$(request.auth.uid))
        && get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.status == 'aprovado';
    }

    // ---------- Administradores (só leitura do próprio documento; escrita só pelo console) ----------
    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Perfis de acesso: pendente / aprovado / bloqueado ----------
    match /perfis/{uid} {
      allow get: if logado() && (request.auth.uid == uid || ehAdmin());
      allow list: if ehAdmin();
      // o próprio usuário só pode se cadastrar como "pendente"
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.keys().hasOnly(['email', 'nome', 'status', 'criadoEm']);
      // só o administrador muda o status
      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decididoEm', 'decididoPor']);
      // o usuário pode excluir o próprio perfil (exclusão de conta); o administrador também
      allow delete: if ehAdmin() || (logado() && request.auth.uid == uid);
    }

    // ---------- Dados pessoais de cada usuário ----------
    // Lê o próprio dado sempre (permite exportar/excluir); grava só se aprovado.
    match /dados_pessoais/{uid}/{colecao}/{docId} {
      allow read: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid && aprovado();
      allow delete: if logado() && request.auth.uid == uid;
    }
  }
}
